<?xml version="1.0"?>
<sdf version="1.9">
  <model name="inspection_wall">
    <static>true</static>
    <!-- Wall centre is 10 m ahead of the home position and 2 m above ground;
         ArduPilot SITL reports the 3 m inspection flight at Gazebo Z≈3 m. -->
    <pose>10 0 2 0 0 0</pose>
    <link name="wall_link">
      <collision name="wall_collision"><geometry><box><size>0.25 24 4</size></box></geometry></collision>
      <visual name="concrete_backing">
        <geometry><box><size>0.25 24 4</size></box></geometry>
        <material><diffuse>0.38 0.38 0.36 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <!-- Blank physical backing wall. The smaller front-mounted planes below
           are the only crack-photo materials visible to the camera. -->
      <visual name="inspection_facade">
        <pose>-0.16 0 1.0 0 0 0</pose>
        <geometry><box><size>0.04 23.4 3.2</size></box></geometry>
        <material><ambient>0.78 0.72 0.62 1</ambient><diffuse>0.78 0.72 0.62 1</diffuse><emissive>0.30 0.26 0.20 1</emissive><specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <!-- The vehicle approaches from lower local X.  Each plane is 4 m from
           its neighbour and has a dedicated NED waypoint, so a real camera
           capture contains exactly one mounted crack image. -->
      <visual name="panel_01"><pose>-0.215 -8 0.9 0 -1.5708 0</pose><geometry><plane><size>2.2 2.2</size></plane></geometry><cast_shadows>false</cast_shadows><material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.72 0.70 0.66 1</diffuse><pbr><metal><albedo_map>model://inspection_wall/materials/textures/panel_01.jpg</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <visual name="panel_02"><pose>-0.215 -4 0.9 0 -1.5708 0</pose><geometry><plane><size>2.2 2.2</size></plane></geometry><cast_shadows>false</cast_shadows><material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.72 0.70 0.66 1</diffuse><pbr><metal><albedo_map>model://inspection_wall/materials/textures/panel_02.jpg</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <visual name="panel_03"><pose>-0.215 0 0.9 0 -1.5708 0</pose><geometry><plane><size>2.2 2.2</size></plane></geometry><cast_shadows>false</cast_shadows><material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.72 0.70 0.66 1</diffuse><pbr><metal><albedo_map>model://inspection_wall/materials/textures/panel_03.jpg</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <visual name="panel_04"><pose>-0.215 4 0.9 0 -1.5708 0</pose><geometry><plane><size>2.2 2.2</size></plane></geometry><cast_shadows>false</cast_shadows><material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.72 0.70 0.66 1</diffuse><pbr><metal><albedo_map>model://inspection_wall/materials/textures/panel_04.jpg</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <visual name="panel_05"><pose>-0.215 8 0.9 0 -1.5708 0</pose><geometry><plane><size>2.2 2.2</size></plane></geometry><cast_shadows>false</cast_shadows><material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.72 0.70 0.66 1</diffuse><pbr><metal><albedo_map>model://inspection_wall/materials/textures/panel_05.jpg</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
    </link>
  </model>
</sdf>
