<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="aeroinspect_inspection">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <scene><ambient>1 1 1 1</ambient><background>0.20 0.24 0.25 1</background></scene>
    <!-- This is also used when the world is opened directly.  The launcher
         supplies Harmonic's full stock GUI configuration for the review
         session, which includes the scene controls omitted here. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="Inspection environment">
        <gz-gui>
          <title>Inspection environment</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.55 1</ambient_light>
        <background_color>0.20 0.24 0.25 1</background_color>
        <!-- A close, deterministic look-at pose for the wall. The camera is
             placed south-west of the wall and points toward its centre; this
             keeps the scene useful even when Gazebo restores a blank layout. -->
        <camera_pose>4 -12 6 0 0.28 1.10</camera_pose>
        <camera_clip><near>0.1</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
        <service>/world/aeroinspect_inspection/control</service>
        <stats_topic>/world/aeroinspect_inspection/stats</stats_topic>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree" />
    </gui>
    <spherical_coordinates><latitude_deg>-35.363262</latitude_deg><longitude_deg>149.165237</longitude_deg><elevation>584</elevation><heading_deg>0</heading_deg><surface_model>EARTH_WGS84</surface_model></spherical_coordinates>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1.0</intensity><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><diffuse>0.16 0.18 0.18 1</diffuse></material></visual></link></model>
    <include><uri>model://iris_with_gimbal</uri><name>aeroinspect_iris</name><pose>0 0 0.25 0 0 0</pose></include>
    <include><uri>model://inspection_wall</uri></include>
  </world>
</sdf>
