# AeroInspectAI Backend Configuration
# Copy this file to .env and update paths as needed

# Application settings
AEROINSPECT_DEBUG=False

# Model paths
AEROINSPECT_MODEL_PATH=../experiments/exp001_yolov8n_seg/runs/baseline/weights/best.pt
AEROINSPECT_DATASET_YAML=../datasets/aeroinspect_crack_v1/aeroinspect_crack_v1.yaml

# Device configuration
AEROINSPECT_DEVICE=0
AEROINSPECT_CUDA_ENABLED=True

# Inference parameters (defaults, can be overridden per request)
AEROINSPECT_CONFIDENCE_THRESHOLD=0.25
AEROINSPECT_IOU_THRESHOLD=0.70
AEROINSPECT_IMAGE_SIZE=640

# Storage configuration
AEROINSPECT_STORAGE_DIR=./storage
AEROINSPECT_UPLOAD_DIR=./storage/uploads
AEROINSPECT_RESULT_DIR=./storage/results
AEROINSPECT_INSPECTION_DIR=./storage/inspections

# Upload limits
AEROINSPECT_MAX_UPLOAD_MB=20

# CORS configuration (frontend URL)
AEROINSPECT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
